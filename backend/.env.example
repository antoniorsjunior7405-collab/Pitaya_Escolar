NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:8081
# Postgres na nuvem (Neon). Use a connection string com pooling.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Segredo dos tokens (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
# E-mail da recuperação de senha (Resend). Sem a chave, em desenvolvimento o link aparece no log.
# EMAIL_RESEND_API_KEY=re_xxxxxxxx
# Remetente com domínio verificado no Resend (o padrão onboarding@resend.dev só entrega para você).
# EMAIL_REMETENTE=Pitaya Escolar <nao-responda@seu-dominio.com.br>
# O que o link do e-mail abre: deep link do app (padrão) ou uma página https que redireciona.
# EMAIL_URL_REDEFINIR_SENHA=pitayaescolar://redefinir-senha
